# Motion+ private registry. ${MOTION_TOKEN} is read from the environment at
# install time and is never written here: set it in your shell (pnpm does not
# read .env files) and as a Vercel environment variable. This repo is public,
# so the token itself must never be committed.
@motionplus:registry=https://api.motion.dev/npm/
//api.motion.dev/npm/:_authToken=${MOTION_TOKEN}
